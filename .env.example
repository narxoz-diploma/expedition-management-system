# Скопировать в .env.local и подставить значения. .env.local в git не попадает.
#
# Оба значения берутся в панели Supabase: Project Settings → API.
# Ключ publishable — публичный, он и так уезжает в клиентский бандл; защита
# данных держится не на нём, а на политиках RLS. Секретный ключ (secret /
# service_role) сюда класть НЕЛЬЗЯ: префикс NEXT_PUBLIC_ означает, что
# значение будет видно любому посетителю сайта.
#
# Те же переменные надо завести на Vercel: Settings → Environment Variables,
# для всех трёх окружений (Production, Preview, Development).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Рубильник технических работ — необязательный, по умолчанию выключен.
# MAINTENANCE_MODE=true показывает всем посетителям страницу «идут работы»
# вместо сайта, в базу при этом не ходит вовсе. Себе — обход: один раз
# открыть сайт с ?bypass=<MAINTENANCE_BYPASS_TOKEN> в адресе, дальше держит
# кука 30 дней. Без токена включённый режим блокирует и тебя — это осознанно,
# см. src/lib/maintenance.ts.
MAINTENANCE_MODE=
MAINTENANCE_BYPASS_TOKEN=
